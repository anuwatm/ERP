    {
      "id": "sent-partial",
      "from": "sent",
      "to": "partial",
      "variant": "default"
    },
    {
      "id": "partial-paid",
      "from": "partial",
      "to": "paid",
      "variant": "emphasis"
    },
    {
      "id": "sent-overdue",
      "from": "sent",
      "to": "overdue",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    }
