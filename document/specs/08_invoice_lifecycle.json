    {
      "id": "terminal",
      "label": "Terminal Exits"
    }
  ],
  "states": [
    {
      "id": "draft",
      "type": "start",
      "label": "Draft",
      "sublabel": "Editable Items",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "Unlocked"
    },
    {
      "id": "sent",
      "type": "active",
      "label": "Issued",
      "sublabel": "Sent to Client",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "Locked"
    },
    {
      "id": "partial",
      "type": "active",
      "label": "Partial Paid",
      "sublabel": "Balance Remaining",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "DECIMAL"
    },
    {
      "id": "paid",
      "type": "success",
      "label": "Paid",
      "sublabel": "Balance Settled",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "Cash In"
    },
    {
      "id": "overdue",
      "type": "waiting",
      "label": "Overdue",
      "sublabel": "Past Due Date",
      "lane": "waiting",
      "col": 0,
      "tag": "Aging"
    },
    {
      "id": "void",
      "type": "failure",
      "label": "Void",
      "sublabel": "No Payment Collected",
      "lane": "terminal",
      "col": 2,
