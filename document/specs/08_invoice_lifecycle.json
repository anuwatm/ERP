          "draft",
          "sent",
          "partial",
          "paid"
        ],
        "note": "Configured invoice status values from editable draft through full payment."
      },
      {
        "id": "overdue-handling",
        "label": "Overdue Aging Management",
        "focus": [
          "sent",
          "overdue",
          "partial"
        ],
        "note": "Aging invoices past payment terms awaiting customer settlement."
      },
      {
        "id": "cancellation-paths",
        "label": "Void Rules",
        "focus": [
          "draft",
          "sent",
          "void"
        ],
        "note": "Invoices can be voided only when no payment has been collected."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Settlement Phases"
    },
    {
      "id": "waiting",
      "label": "Aging & Overdue"
