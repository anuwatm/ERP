{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Master Dialog Standard & Single Active Editor Lifecycle",
    "subtitle": "Phase 23.1 unified modal dialog, dirty state detection, switch coordination, and idempotent retry",
    "output": "document/16_master_dialog_editor_lifecycle.html",
    "viewBox": [
      980,
      620
    ],
    "animation": "none",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "draft-editing",
        "label": "Draft Editing & Modification",
        "focus": [
          "draft",
          "editing",
          "submitting"
        ],
        "note": "User opens Create or Edit dialog; in-memory state tracks pristine vs modified field status across all control types."
      },
      {
        "id": "switch-guard",
        "label": "Switch Coordinator & Guard",
        "focus": [
          "editing",
          "submitting",
          "intercepted"
        ],
        "note": "Single active editor rule intercepts navigation or opening a new form; user confirms Keep or Discard."
      },
      {
        "id": "submission-and-retry",
        "label": "Submission & Safe Retry",
        "focus": [
          "submitting",
          "committed",
          "validation_err"
        ],
        "note": "Idempotent submission key protects against double-submit; 422 errors keep draft data for zero-loss correction."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Active Editor Lifecycle"
    },
    {
      "id": "terminal",
      "label": "Guard & Error Outcomes"
    }
  ],
  "states": [
    {
      "id": "draft",
      "type": "start",
      "label": "Dialog Opened",
      "sublabel": "Initial draft / prefill",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "Pristine"
    },
    {
      "id": "editing",
      "type": "active",
      "label": "Draft Modified",
      "sublabel": "Field changes detected",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "Dirty Tracked"
    },
    {
      "id": "submitting",
      "type": "active",
      "label": "Active Submission",
      "sublabel": "UUID key & locked",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "Key Locked"
    },
    {
      "id": "committed",
      "type": "success",
      "label": "Saved & Closed",
      "sublabel": "Receipt recorded",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "Committed"
    },
    {
      "id": "intercepted",
      "type": "waiting",
      "label": "Switch Intercepted",
      "sublabel": "Discard changes guard",
      "lane": "terminal",
      "col": 1,
      "tag": "Keep or Discard",
      "yOffset": -40.0
    },
    {
      "id": "validation_err",
      "type": "failure",
      "label": "Validation 422",
      "sublabel": "Draft preserved for retry",
      "lane": "terminal",
      "col": 2,
      "tag": "Safe Retry",
      "yOffset": -40.0
    }
  ],
  "transitions": [
    {
      "id": "t-draft-editing",
      "from": "draft",
      "to": "editing",
      "variant": "default"
    },
    {
      "id": "t-editing-submitting",
      "from": "editing",
      "to": "submitting",
      "variant": "emphasis"
    },
    {
      "id": "t-submitting-committed",
      "from": "submitting",
      "to": "committed",
      "variant": "emphasis"
    },
    {
      "id": "t-submitting-intercepted",
      "from": "submitting",
      "to": "intercepted",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "t-submitting-err",
      "from": "submitting",
      "to": "validation_err",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    }
  ]
}
