        "label": "Intent & QR Generation",
        "focus": [
          "client",
          "erp",
          "opn"
        ],
        "note": "ERP reserves transaction intent, creates PromptPay charge, and renders sanitized SVG QR for invoice payment."
      },
      {
        "id": "provider-confirmation",
        "label": "Provider Event Verification",
        "focus": [
          "client",
          "bank",
          "opn",
          "erp"
        ],
        "note": "Customer pays via banking app; Opn notifies ERP, which verifies charge authenticity with merchant credentials without posting GL."
      },
      {
        "id": "settlement-and-gl",
        "label": "Signed Settlement & Accounting Posting",
        "focus": [
          "bridge",
          "erp",
          "gl"
        ],
        "note": "Independent settlement bridge sends signed HMAC payload upon verified bank credit; ERP atomically creates Payment and balanced GL journal."
      }
    ]
